{
  "name": "sharebox-backend",
  "version": "1.0.0",
  "description": "Sharebox Worker: D1 + Gemini classify + LWW sync, serves the PWA",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "jose": "^5.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.148.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply sharebox --local",
    "db:migrate:remote": "wrangler d1 migrations apply sharebox --remote"
  }
}
